{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.internal/contracts/player-data/snapshot.v1.schema.json",
  "title": "player-data weekly projections snapshot",
  "description": "One curated projections document. Scoring format changes the VALUES in `rank` and `proj_points`, never the shape — so all three formats (standard, half-ppr, ppr) share this single schema and `format` records which one a given document is.",
  "type": "object",
  "required": ["format", "season", "week", "generated_at", "players"],
  "additionalProperties": false,
  "properties": {
    "format": { "enum": ["standard", "half-ppr", "ppr"] },
    "season": { "type": "integer", "minimum": 2020, "maximum": 2100 },
    "week": { "type": "integer", "minimum": 1, "maximum": 22 },
    "generated_at": { "type": "string", "format": "date-time" },
    "players": {
      "type": "array",
      "items": { "$ref": "#/$defs/player" }
    }
  },
  "$defs": {
    "player": {
      "type": "object",
      "required": ["id", "name", "pos", "team"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^p_[a-z0-9]+$" },
        "name": { "type": "string", "minLength": 1 },
        "pos": { "enum": ["QB", "RB", "WR", "TE", "K", "DST"] },
        "team": { "type": "string", "minLength": 2, "maxLength": 4 },
        "rank": { "type": "integer", "minimum": 1 },
        "proj_points": { "$ref": "#/$defs/spread" },
        "yahoo_rank": { "type": "integer", "minimum": 1 },
        "espn_rank": { "type": "integer", "minimum": 1 },
        "blurb": { "type": "string", "maxLength": 600 }
      },
      "allOf": [
        {
          "if": { "properties": { "pos": { "const": "DST" } } },
          "then": {
            "required": ["yahoo_rank", "espn_rank"],
            "properties": { "rank": false, "proj_points": false }
          },
          "else": {
            "required": ["rank", "proj_points"],
            "properties": { "yahoo_rank": false, "espn_rank": false }
          }
        }
      ]
    },
    "spread": {
      "type": "object",
      "required": ["floor", "expected", "ceiling"],
      "additionalProperties": false,
      "properties": {
        "floor": { "type": "number", "minimum": 0 },
        "expected": { "type": "number", "minimum": 0 },
        "ceiling": { "type": "number", "minimum": 0 }
      },
      "description": "floor <= expected <= ceiling is the intended invariant. JSON Schema 2020-12 cannot compare sibling properties, so it is not mechanically enforced here — assert it in provider and consumer tests."
    }
  }
}
