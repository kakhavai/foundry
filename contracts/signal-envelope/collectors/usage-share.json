{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://foundry.internal/signal-envelope/collectors/usage-share.json",
  "title": "usage-share collector signal fields",
  "signal_types": {
    "player_usage_weekly": {
      "type": "object",
      "required": ["key", "observed_at", "value"],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "observed_at": { "type": "string", "format": "date-time" },
        "value": { "type": "number" }
      }
    }
  }
}
