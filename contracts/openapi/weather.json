    "/signals/convergence": {
      "get": {
        "description": "The ordered forecast series for one kickoff, with per-snapshot deltas.\nweather's own extra route, not part of the shared five -- derivable from\nthe lake, but every consumer would otherwise reimplement it.",
        "operationId": "convergence_signals_convergence_get",
        "parameters": [
          {
            "in": "query",
            "name": "game_id",
            "required": true,
            "schema": {
              "title": "Game Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "season",
            "required": false,
            "schema": {
              "default": 2026,
              "title": "Season",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "week",
            "required": false,
            "schema": {
              "default": 1,
              "title": "Week",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
