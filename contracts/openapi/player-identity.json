  "paths": {
    "/catalog": {
      "get": {
        "description": "Self-description. The registry says a collector exists; this says\nwhat it currently offers.",
        "operationId": "catalog_catalog_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Catalog"
      }
    },
    "/health": {
